// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../db/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  credit           Int              @default(10)
  shareable_links shareable_link[]
  accounts         Account[]
  sessions         Session[]
  played           Played[]
  likes            likedMonologue[]
  comments         Comment[]
  liked_categories categories[]
  monologues       Monologue[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Monologue {
  id           String     @id @default(cuid())
  title        String
  createdBy    String     @map("created_by")
  playedCount  Int?       @default(0) @map("played_count")
  likeCount    Int?       @default(0) @map("like_count")
  commentCount Int?       @default(0) @map("comment_count")
  categories   categories
  playedby     Played[]
  visibility   VISIBILITY @default(PRIVATE)
  thumbnailUrl String     @default("PENDING") @map("thumbnail_url")

  user User @relation(fields: [createdBy], references: [id])

  createdAt       DateTime         @default(now()) @map("created_at")
  shareable_links shareable_link[]
  likedMonologues likedMonologue[]
  episodes        Episodes[]
  comments        Comment[]


  @@unique([title, createdBy])
  @@map("monologues")
}

enum VISIBILITY {
  PRIVATE
  PUBLIC
  LINK
}

model Episodes {
  id          String  @id @default(cuid())
  title       String?
  number      Int
  script      String?
  audioUrl    String? @map("audio_url")
  monologueId String  @map("monologue_id")
  status      STATUS  @default(PENDING)

  monologue Monologue @relation(fields: [monologueId], references: [id], onDelete: Cascade)

  @@unique([monologueId, number])
  @@map("episodes")
}

enum STATUS {
  PENDING
  GENERATING_AUDIO
  ERROR
  READY
}

model Played {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  monologueId String @map("monologue_id")

  monologue Monologue @relation(fields: [monologueId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("played_by")
}

model likedMonologue {
  id          String @id @default(cuid())
  userId      String @map("user_id")
  monologueId String @map("monologue_id")

  monologue Monologue @relation(fields: [monologueId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("liked_monologues")
  @@unique([userId,monologueId])
}

model Comment {
  id          String @id @default(cuid())
  comment     String
  monologueId String @map("monologue_id")
  userId      String

  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])
  monologue Monologue @relation(fields: [monologueId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model shareable_link {
  id String @id @default(uuid())
  userId String @map("user_id")
  monologueId String @map("monologue_id")
  isValid Boolean @map("is_valid")

  user User @relation(fields: [userId],references: [id]) 
  monologue Monologue @relation(fields: [monologueId],references: [id]) 
}

enum categories {
  Motivation
  Science
  Dramatic
  Comedy
  Soliloquy
  Interior
  Action
  Serio_comic
  Narrative
  Storytelling
  Classical
  Contemporary
  Villain_Speech
  Rant
  Direct_Address
  Historical
}
